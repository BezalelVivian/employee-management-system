# Copy to .env for local development. On Vercel/Render set these as environment variables instead.
# NEVER commit the real .env or the service-account key.

SPREADSHEET_ID=the-long-id-from-your-google-sheet-url
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...whole key JSON on ONE line...}
JWT_SECRET=a-long-random-string-at-least-32-characters
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# Optional
APP_TIMEZONE=Asia/Kolkata
# First day EMS should track attendance. For this go-live: 2026-10-08
ATTENDANCE_START_DATE=2026-10-08
SHEET_CACHE_TTL_SECONDS=15
