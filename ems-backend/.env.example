# Copy to .env for local development. On Vercel, add these in Project -> Settings -> Environment Variables.
# NEVER commit the real .env or the service-account key.

# ---- Required ----
SPREADSHEET_ID=the-long-id-from-your-google-sheet-url
# The ENTIRE service-account key file, pasted as the value (one line or many both work).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...whole key JSON...}
# A long random string (32+ chars). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=a-long-random-string-at-least-32-characters
# Your frontend URL(s), comma separated. A trailing slash is fine.
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# ---- Set this when you go live ----
# First day EMS was actually used. Working days before it with no record show "Not Tracked", not "Absent".
EMS_START_DATE=2026-10-08

# ---- Optional ----
APP_TIMEZONE=Asia/Kolkata
# Vercel runs several copies of the API; each keeps its own short cache. A longer value protects the
# Google Sheets quota (60 reads/min). 15 is a good starting point.
SHEET_CACHE_TTL_SECONDS=15
# Also allow Vercel preview deployments (random URLs), e.g.:
# CORS_ORIGIN_REGEX=https://your-frontend-.*\.vercel\.app
# WEEKLY_OFF_DAYS=6
